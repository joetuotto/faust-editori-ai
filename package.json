{
  "name": "faust",
  "version": "3.0.0-alpha.1",
  "description": "FAUST - suomenkielinen kirjoituseditori DEIS- ja NOX-moodeilla",
  "author": "FAUST Team",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run && jest",
    "test:app": "vitest run",
    "test:legacy": "jest",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit -p app/tsconfig.json && tsc --noEmit",
    "build-mac": "npm run build && electron-builder --mac",
    "build-win": "npm run build && electron-builder --win",
    "build-linux": "npm run build && electron-builder --linux",
    "legacy:build": "webpack --mode=production && node scripts/post-build.js",
    "legacy:dev": "webpack --mode=development --watch",
    "legacy:start": "npm run legacy:build && electron electron.js",
    "legacy:verify-build": "node scripts/verify-assets.js",
    "legacy:test:electron": "electron-mocha --require test/setup.js test/electron"
  },
  "build": {
    "appId": "com.faust.app",
    "productName": "FAUST",
    "copyright": "Copyright © 2025-2026",
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/faust-dock-icon.icns",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "FAUST Installer",
      "artifactName": "FAUST-DMG-INSTALLER-${arch}.dmg",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-installer"
    },
    "asarUnpack": [
      "node_modules/@yongsk0066/voikko/**"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/runtime": "^7.28.6",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-loader": "^10.0.0",
    "diff": "^8.0.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-mocha": "^13.1.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs-extra": "^11.3.3",
    "html-webpack-plugin": "^5.6.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "zustand": "^5.0.15"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist",
      "<rootDir>/dist-installer"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/integration/\\._.*",
      "<rootDir>/test/electron/\\._.*",
      "/\\._.*"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js",
      "<rootDir>/test/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "electron.js",
      "preload.js",
      "!node_modules/**",
      "!test/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google/genai": "^2.24.0",
    "@yongsk0066/voikko": "^0.4.0",
    "docx": "^8.5.0",
    "dotenv": "^17.2.3",
    "isomorphic-git": "^1.42.3",
    "jszip": "^3.10.2",
    "openai": "^6.17.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "$diff"
  }
}
